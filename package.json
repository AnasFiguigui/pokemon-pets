{
    "name": "pokemon-pets",
    "displayName": "Pokemon Pets",
    "description": "A virtual pet extension featuring Pokemons.",
    "version": "1.5.0",
    "publisher": "Anasfiguigui",
    "author": {
        "name": "Anasfiguigui"
    },
    "license": "MIT",
    "icon": "media/icons/icon.png",
    "galleryBanner": {
        "color": "#F1C40F",
        "theme": "dark"
    },
    "pricing": "Free",
    "keywords": [
        "pokemon",
        "vscode",
        "vs-code",
        "vscode-pets",
        "pokemon-pets",
        "pokemon-companion",
        "pokemon-extension",
        "coding-pets",
        "pixel-pets",
        "pixel-art",
        "pixel-pokemon",
        "gamified-coding",
        "developer-pets",
        "desktop-pets",
        "coding-companion",
        "productivity-fun",
        "programmer-pets",
        "retro-pixel",
        "dev-toys",
        "editor-companion",
        "ide-pets",
        "pokemon-fans",
        "game-dev-tools",
        "pixel-gamification"
    ],
    "categories": [
        "Other"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Anasfiguigui/Pokemon-Pets"
    },
    "engines": {
        "vscode": "^1.92.0"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        },
        "virtualWorkspaces": true
    },
    "contributes": {
        "configuration": {
            "title": "Pokemon Pets",
            "properties": {
                "pokemon-pets.background": {
                    "type": "string",
                    "default": "Pokemon_grass",
                    "enum": [
                        "Grass",
                        "Sand",
                        "Snow",
                        "Pokemon_grass",
                        "Non_pokemon_grass",
                        "Minecraft_grass",
                        "Beach",
                        "Floor1",
                        "Floor3",
                        "Floor4",
                        "Ground2",
                        "Ground3"
                    ],
                    "description": "The background theme for the window."
                },
                "pokemon-pets.scale": {
                    "type": "string",
                    "default": "Medium",
                    "enum": [
                        "Small",
                        "Medium",
                        "Big"
                    ],
                    "description": "The size of the pets."
                },
                "pokemon-pets.menuScale": {
                    "type": "string",
                    "default": "Default",
                    "enum": [
                        "Small",
                        "Default",
                        "Large"
                    ],
                    "description": "The size of the in-game menus."
                },
                "pokemon-pets.wild": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggles if wild Pokémon can spawn."
                },
                "pokemon-pets.maxPokemon": {
                    "type": "number",
                    "default": 6,
                    "minimum": 1,
                    "maximum": 12,
                    "description": "Maximum number of Pokémon you can have at once (1–12)."
                },
                "pokemon-pets.dayNightCycle": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enables the day/night cycle that tints the background based on the time of day."
                },
                "pokemon-pets.filter": {
                    "type": "string",
                    "default": "None",
                    "enum": [
                        "None",
                        "Grayscale",
                        "Sepia",
                        "High Contrast",
                        "CRT Retro",
                        "Soft Night"
                    ],
                    "description": "Visual filter applied to the game scene. Only affects the pixel art, not the UI."
                },
                "pokemon-pets.telemetry": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable local telemetry to track your personal stats (Pokémon added, candy fed, gold earned, etc.). All data stays in your save file — nothing is sent externally."
                },
                "pokemon-pets.rewards.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable coding activity rewards — earn gold and friendship for your Pokémon as you code."
                },
                "pokemon-pets.rewards.saveGold": {
                    "type": "number",
                    "default": 2,
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Gold earned per file save."
                },
                "pokemon-pets.rewards.savesPerFriendship": {
                    "type": "number",
                    "default": 10,
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "Number of file saves needed to grant +1 friendship to a random pet."
                },
                "pokemon-pets.rewards.saveCooldownSeconds": {
                    "type": "number",
                    "default": 120,
                    "minimum": 0,
                    "maximum": 3600,
                    "description": "Per-file cooldown in seconds — repeated saves of the same file within this window are ignored."
                },
                "pokemon-pets.rewards.pushGold": {
                    "type": "number",
                    "default": 200,
                    "minimum": 0,
                    "maximum": 10000,
                    "description": "Gold earned per Git push."
                },
                "pokemon-pets.rewards.pushCandy": {
                    "type": "number",
                    "default": 1,
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Candy given to a random pet per Git push."
                },
                "pokemon-pets.rewards.pushFriendship": {
                    "type": "number",
                    "default": 5,
                    "minimum": 0,
                    "maximum": 255,
                    "description": "Friendship added to all pets per Git push."
                }
            }
        },
        "commands": [
            {
                "command": "pokemon-pets.toggleAutoFeed",
                "title": "Auto Feed: OFF",
                "icon": {
                    "light": "media/icons/light/switch-off.svg",
                    "dark": "media/icons/dark/switch-off.svg"
                }
            },
            {
                "command": "pokemon-pets.toggleAutoFeedOff",
                "title": "Auto Feed: ON",
                "icon": {
                    "light": "media/icons/light/switch-on.svg",
                    "dark": "media/icons/dark/switch-on.svg"
                }
            },
            {
                "command": "pokemon-pets.addPet",
                "title": "Add Pokémon",
                "icon": {
                    "light": "media/icons/light/add.svg",
                    "dark": "media/icons/dark/add.svg"
                }
            },
            {
                "command": "pokemon-pets.removePet",
                "title": "Remove Pokémon",
                "icon": {
                    "light": "media/icons/light/remove.svg",
                    "dark": "media/icons/dark/remove.svg"
                }
            },
            {
                "command": "pokemon-pets.toggleTopBar",
                "title": "Wallet toggler",
                "icon": {
                    "light": "media/icons/light/wallet.svg",
                    "dark": "media/icons/dark/wallet.svg"
                }
            },
            {
                "command": "pokemon-pets.actions",
                "title": "Menus & Actions",
                "icon": {
                    "light": "media/icons/light/actions.svg",
                    "dark": "media/icons/dark/actions.svg"
                }
            },
            {
                "command": "pokemon-pets.settings",
                "title": "Pokemon Pets Settings",
                "icon": {
                    "light": "media/icons/light/settings.svg",
                    "dark": "media/icons/dark/settings.svg"
                }
            },
            {
                "command": "pokemon-pets.openSaveFile",
                "title": "Pokemon Pets: Open save file (JSON)"
            },
            {
                "command": "pokemon-pets.reloadSaveFile",
                "title": "Pokemon Pets: Reload save file"
            },
            {
                "command": "pokemon-pets.exportSave",
                "title": "Pokemon Pets: Export save to clipboard"
            },
            {
                "command": "pokemon-pets.importSave",
                "title": "Pokemon Pets: Import save from clipboard"
            },
            {
                "command": "pokemon-pets.showStats",
                "title": "Pokemon Pets: Show stats"
            },
            {
                "command": "pokemon-pets.renamePet",
                "title": "Pokemon Pets: Rename Pokémon"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "pokemon-pets.addPet",
                    "when": "view == pokemon-pets",
                    "group": "navigation@0"
                },
                {
                    "command": "pokemon-pets.removePet",
                    "when": "view == pokemon-pets",
                    "group": "navigation@1"
                },
                {
                    "command": "pokemon-pets.toggleAutoFeed",
                    "when": "view == pokemon-pets && !pokemon-pets.autoFeedOn",
                    "group": "navigation@2"
                },
                {
                    "command": "pokemon-pets.toggleAutoFeedOff",
                    "when": "view == pokemon-pets && pokemon-pets.autoFeedOn",
                    "group": "navigation@2"
                },
                {
                    "command": "pokemon-pets.toggleTopBar",
                    "when": "view == pokemon-pets",
                    "group": "navigation@3"
                },
                {
                    "command": "pokemon-pets.actions",
                    "when": "view == pokemon-pets",
                    "group": "navigation@4"
                },
                {
                    "command": "pokemon-pets.settings",
                    "when": "view == pokemon-pets",
                    "group": "navigation@5"
                }
            ]
        },
        "views": {
            "explorer": [
                {
                    "id": "pokemon-pets",
                    "name": "Pokemon Pets",
                    "icon": "media/icons/icon.png",
                    "contextualTitle": "Pokemon pets for VSCode",
                    "type": "webview"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile && npm run bundle",
        "compile": "tsc -p ./",
        "bundle": "webpack --mode production",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.7",
        "@types/node": "20.x",
        "@types/vscode": "^1.92.0",
        "@typescript-eslint/eslint-plugin": "^7.14.1",
        "@typescript-eslint/parser": "^7.11.0",
        "@vscode/test-cli": "^0.0.9",
        "@vscode/test-electron": "^2.4.0",
        "eslint": "^8.57.0",
        "terser-webpack-plugin": "^5.4.0",
        "typescript": "5.5.4",
        "vitest": "^4.0.18",
        "webpack": "^5.106.2",
        "webpack-cli": "^7.0.2"
    }
}
